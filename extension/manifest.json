{
  "manifest_version": 3,
  "name": "Emoh Focus — Mindful Site Blocker",
  "short_name": "Emoh Focus",
  "version": "0.1.0",
  "description": "Block distracting sites during focus sessions and check in with your mood. 100% local — nothing leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Emoh Focus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["blocked/blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
